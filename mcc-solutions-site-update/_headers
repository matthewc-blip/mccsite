# Cloudflare Pages custom headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Global security headers — applied to every response
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Long-cache immutable static assets (filenames don't change on edit, so safe to cache hard)
/og-image.png
  Cache-Control: public, max-age=31536000, immutable
/og-image.svg
  Cache-Control: public, max-age=31536000, immutable
/headshot.jpg
  Cache-Control: public, max-age=31536000, immutable
/manifest.json
  Cache-Control: public, max-age=86400

# HTML pages — allow revalidation so edits go live promptly, and explicitly
# confirm indexing/crawling permission at the header level as well as in
# robots.txt (belt and suspenders for search + AI crawlers)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: all

# llms.txt and robots.txt should always be fetched fresh
/llms.txt
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
